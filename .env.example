# Vercel / production
# Sample PROFILE_JSON: docs/profile.sample.json (Jordan Lee Applied AI demo).
# Prefer editing Your details in the UI for any sector — that persists into app state.
PROFILE_JSON=
RESUME_URL=

# Required on Vercel: cron routes reject requests without this in production.
# Vercel Cron injects Authorization: Bearer <CRON_SECRET> when the env var is set.
CRON_SECRET=

# Optional
RESUME_BYTES=
JOB_DESK_URL=http://localhost:3000

# Required on Vercel for persistent pipeline / profile / résumé state
# BLOB_READ_WRITE_TOKEN=
